#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

PROJECT_ROOT = Path(__file__).resolve().parent
SRC_ROOT = PROJECT_ROOT / "src"
if str(SRC_ROOT) not in sys.path:
    sys.path.insert(0, str(SRC_ROOT))

from yomi_corpus.pipeline import PipelineWorkspace


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Prepare the next batch for a pipeline track."
    )
    parser.add_argument(
        "args",
        nargs="+",
        help="Either <documents> or <track> <documents>.",
    )
    parser.add_argument(
        "--yomi-unit-mode",
        choices=["sentence", "comma_span"],
        help="Yomi triage/repair work-item mode for this batch.",
    )
    parser.add_argument(
        "--yomi-auto-accept-profile",
        choices=["off", "strict", "stable_two_kanji"],
        help="Yomi auto-accept profile for this batch.",
    )
    parser.add_argument(
        "--llm-profile",
        action="append",
        default=[],
        metavar="TASK=PROFILE",
        help=(
            "Override one LLM task profile for this batch. "
            "Repeatable; profiles are smoke, economy, standard, strong."
        ),
    )
    parser.add_argument(
        "--llm-execution-mode",
        action="append",
        default=[],
        metavar="TASK=MODE",
        help=(
            "Override one LLM task execution mode for this batch. "
            "Repeatable; modes are sync and batch."
        ),
    )
    return parser.parse_args()


def main() -> None:
    parsed = parse_args()
    if len(parsed.args) == 1:
        track_name = "working"
        target_documents = int(parsed.args[0])
    elif len(parsed.args) == 2:
        track_name = parsed.args[0]
        target_documents = int(parsed.args[1])
    else:
        raise SystemExit("Usage: prepare [options] <documents> | prepare [options] dev <documents>")

    yomi_policy = {}
    if parsed.yomi_unit_mode:
        yomi_policy["unit_mode"] = parsed.yomi_unit_mode
    if parsed.yomi_auto_accept_profile:
        yomi_policy["auto_accept_profile"] = parsed.yomi_auto_accept_profile
    llm_policy = {}
    for override in parsed.llm_profile:
        if "=" not in override:
            raise SystemExit(f"Invalid --llm-profile value: {override}. Expected TASK=PROFILE.")
        task, profile = override.split("=", 1)
        task = task.strip()
        profile = profile.strip()
        if not task or not profile:
            raise SystemExit(f"Invalid --llm-profile value: {override}. Expected TASK=PROFILE.")
        llm_policy[task] = profile
    llm_execution_policy = {}
    for override in parsed.llm_execution_mode:
        if "=" not in override:
            raise SystemExit(f"Invalid --llm-execution-mode value: {override}. Expected TASK=MODE.")
        task, mode = override.split("=", 1)
        task = task.strip()
        mode = mode.strip()
        if not task or not mode:
            raise SystemExit(f"Invalid --llm-execution-mode value: {override}. Expected TASK=MODE.")
        llm_execution_policy[task] = mode

    workspace = PipelineWorkspace(PROJECT_ROOT)
    summary = workspace.prepare_next_batch(
        track_name=track_name,
        target_documents=target_documents,
        yomi_policy=yomi_policy or None,
        llm_policy=llm_policy or None,
        llm_execution_policy=llm_execution_policy or None,
    )
    print(json.dumps(summary, ensure_ascii=False, indent=2))


if __name__ == "__main__":
    main()
