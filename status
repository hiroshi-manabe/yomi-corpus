#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

PROJECT_ROOT = Path(__file__).resolve().parent
SRC_ROOT = PROJECT_ROOT / "src"
if str(SRC_ROOT) not in sys.path:
    sys.path.insert(0, str(SRC_ROOT))

from yomi_corpus.pipeline import PipelineWorkspace
from yomi_corpus.cli_format import format_stage_summary


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Report the current batch and stage for a pipeline track."
    )
    parser.add_argument(
        "track",
        nargs="?",
        choices=["working", "dev"],
        default="working",
        help="Track to inspect. Defaults to working.",
    )
    parser.add_argument(
        "--stages",
        "--stage",
        action="store_true",
        dest="stages",
        help="Print only the completed current stage and the next stage.",
    )
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    workspace = PipelineWorkspace(PROJECT_ROOT)
    summary = workspace.status(track_name=args.track)
    if args.stages:
        print(format_stage_summary(summary))
    else:
        print(json.dumps(summary, ensure_ascii=False, indent=2))


if __name__ == "__main__":
    main()
