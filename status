#!/usr/bin/env python3
from __future__ import annotations

import argparse
import subprocess
import sys
from pathlib import Path


PROJECT_ROOT = Path(__file__).resolve().parent


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Compatibility wrapper for ./next --status."
    )
    parser.add_argument(
        "track",
        nargs="?",
        choices=["working", "dev"],
        default="working",
        help="Track to inspect. Defaults to working.",
    )
    parser.add_argument(
        "--stages",
        "--stage",
        action="store_true",
        dest="stages",
        help="Print only the completed current stage and the next stage.",
    )
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    command = [
        sys.executable,
        str(PROJECT_ROOT / "next"),
        args.track,
        "--status",
    ]
    if args.stages:
        command.append("--stages")
    else:
        command.append("--json")
    raise SystemExit(subprocess.run(command, cwd=PROJECT_ROOT, check=False).returncode)


if __name__ == "__main__":
    main()
