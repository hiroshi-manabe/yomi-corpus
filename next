#!/usr/bin/env python3
from __future__ import annotations

import json
import argparse
from datetime import datetime, timezone
from pathlib import Path
import sys

PROJECT_ROOT = Path(__file__).resolve().parent
SRC_ROOT = PROJECT_ROOT / "src"
if str(SRC_ROOT) not in sys.path:
    sys.path.insert(0, str(SRC_ROOT))

from yomi_corpus.pipeline import PipelineWorkspace
from yomi_corpus.pipeline import LLM_EXECUTION_MODES
from yomi_corpus.pipeline import RERUNNABLE_STAGES

LLM_STATUS_STAGE_PREFIXES = {
    "alphabetic_llm_judged": "alphabetic_judgment",
    "scope_triage_llm_completed": "scope_triage",
    "yomi_reading_llm_completed": "yomi_reading",
}


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Advance the current batch on the requested track."
    )
    parser.add_argument(
        "track",
        nargs="?",
        choices=["working", "dev"],
        default="working",
        help="Track to advance. Defaults to working.",
    )
    parser.add_argument(
        "--force-stage",
        choices=sorted(RERUNNABLE_STAGES),
        help="Rerun the current completed stage instead of advancing to the next one.",
    )
    parser.add_argument(
        "--yes",
        action="store_true",
        help="Allow overwriting protected-track artifacts without an interactive prompt.",
    )
    parser.add_argument(
        "--skip-review-gates",
        action="store_true",
        help="Allow non-working tracks to continue past a generated human-review gate.",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Print the full structured summary instead of concise operator output.",
    )
    parser.add_argument(
        "--auto",
        action="store_true",
        help="Keep advancing until a human gate, incomplete stage, or final stage is reached.",
    )
    parser.add_argument(
        "--llm-mode",
        choices=sorted(LLM_EXECUTION_MODES),
        help=(
            "Override the LLM execution mode for this invocation only. "
            "Valid only when the stage being run calls the LLM."
        ),
    )
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    workspace = PipelineWorkspace(PROJECT_ROOT)
    if args.auto and args.force_stage:
        raise SystemExit("--auto cannot be combined with --force-stage")
    summary = (
        advance_auto(workspace, args)
        if args.auto
        else workspace.advance(
            track_name=args.track,
            force_stage=args.force_stage,
            allow_overwrite=args.yes,
            skip_review_gates=args.skip_review_gates,
            llm_execution_mode_override=args.llm_mode,
        )
    )
    if summary.get("requires_confirmation") and not args.yes:
        if not sys.stdin.isatty():
            summary["message"] = (
                "Confirmation required to overwrite existing working-track artifacts. "
                "Re-run interactively or add --yes."
            )
        else:
            batch_name = summary["batch_name"]
            force_stage = summary["requested_force_stage"]
            prompt = (
                f"This will overwrite existing working-track artifacts for "
                f"{batch_name} at stage {force_stage}. Continue? [y/N] "
            )
            answer = input(prompt).strip().lower()
            if answer in {"y", "yes"}:
                summary = (
                    advance_auto(workspace, args, allow_overwrite=True)
                    if args.auto
                    else workspace.advance(
                        track_name=args.track,
                        force_stage=args.force_stage,
                        allow_overwrite=True,
                        skip_review_gates=args.skip_review_gates,
                        llm_execution_mode_override=args.llm_mode,
                    )
                )
            else:
                summary["message"] = "Cancelled."
    log_path = write_pipeline_log(summary)
    summary["log_path"] = str(log_path)
    if args.json:
        print(json.dumps(summary, ensure_ascii=False, indent=2))
    else:
        print(format_next_summary(summary))


def advance_auto(
    workspace: PipelineWorkspace,
    args: argparse.Namespace,
    *,
    allow_overwrite: bool | None = None,
    progress_stream=sys.stderr,
) -> dict[str, object]:
    steps = []
    final_summary: dict[str, object] | None = None
    overwrite = args.yes if allow_overwrite is None else allow_overwrite
    for _ in range(100):
        status_before = workspace.status(args.track)
        if progress_stream is not None:
            print(format_auto_progress_start(status_before), file=progress_stream, flush=True)
        summary = workspace.advance(
            track_name=args.track,
            allow_overwrite=overwrite,
            skip_review_gates=args.skip_review_gates,
            llm_execution_mode_override=args.llm_mode,
        )
        if progress_stream is not None:
            print(format_auto_progress_done(summary), file=progress_stream, flush=True)
        steps.append(
            {
                "stage": summary.get("current_stage"),
                "advanced": summary.get("advanced"),
                "blocking_reason": summary.get("blocking_reason"),
                "next_stage": summary.get("next_stage"),
            }
        )
        final_summary = summary
        if summary.get("requires_confirmation"):
            break
        if summary.get("blocking_reason"):
            break
        if not summary.get("advanced"):
            break
        if not summary.get("next_stage"):
            break
    if final_summary is None:
        final_summary = workspace.status(args.track)
    final_summary["auto"] = True
    final_summary["auto_steps"] = steps
    return final_summary


def format_auto_progress_start(status: dict[str, object]) -> str:
    track = status.get("track_name", "-")
    batch = status.get("batch_name") or status.get("current_batch_name") or "-"
    current_stage = status.get("current_stage") or "-"
    next_stage = status.get("next_stage") or "-"
    if next_stage == "-":
        return f"Auto: checking {track} {batch} (current: {current_stage})"
    return f"Auto: running {next_stage} for {track} {batch} (current: {current_stage})"


def format_auto_progress_done(summary: dict[str, object]) -> str:
    current_stage = summary.get("current_stage") or "-"
    advanced = str(summary.get("advanced")).lower()
    blocking_reason = summary.get("blocking_reason")
    next_stage = summary.get("next_stage")
    if blocking_reason:
        return f"Auto: stopped at {current_stage} (advanced: {advanced}; blocked: {blocking_reason})"
    if next_stage:
        return f"Auto: completed {current_stage} (advanced: {advanced}; next: {next_stage})"
    return f"Auto: completed {current_stage} (advanced: {advanced})"


def write_pipeline_log(summary: dict[str, object]) -> Path:
    now = datetime.now(timezone.utc).replace(microsecond=0)
    date_dir = PROJECT_ROOT / "data" / "pipeline" / "logs" / now.strftime("%Y%m%d")
    date_dir.mkdir(parents=True, exist_ok=True)
    track = str(summary.get("track_name", "unknown"))
    batch = str(summary.get("batch_name") or summary.get("current_batch_name") or "none")
    stage = str(summary.get("current_stage") or summary.get("requested_force_stage") or "none")
    timestamp = now.strftime("%H%M%S")
    path = date_dir / f"{timestamp}_{track}_{batch}_{stage}.json"
    path.write_text(json.dumps(summary, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    return path


def format_next_summary(summary: dict[str, object]) -> str:
    lines = [
        f"Track: {summary.get('track_name', '-')}",
        f"Batch: {summary.get('batch_name') or summary.get('current_batch_name') or '-'}",
        f"Stage: {summary.get('current_stage') or '-'}",
    ]
    artifacts = summary.get("artifacts")
    if isinstance(artifacts, dict):
        review_line = human_review_line(artifacts)
        if review_line:
            lines.append(review_line)
        skipped_line = human_review_skipped_line(artifacts)
        if skipped_line:
            lines.append(skipped_line)
        for prefix in ["alphabetic_judgment", "scope_triage", "yomi_reading", "yomi_reading_retry"]:
            if not should_show_llm_status(summary, artifacts, prefix):
                continue
            completed = artifacts.get(f"{prefix}_llm_job_completed")
            total = artifacts.get(f"{prefix}_llm_job_total")
            if completed is not None and total is not None:
                if str(total) == "0":
                    queued = artifacts.get(f"{prefix}_queued")
                    if queued in (None, "0", 0):
                        lines.append(f"LLM requests ({prefix}): none queued")
                    else:
                        lines.append(f"LLM progress ({prefix}): 0/{total} completed")
                else:
                    failed = artifacts.get(f"{prefix}_llm_job_failed")
                    failure_label = llm_failure_label(artifacts, prefix)
                    failed_text = "" if failed in (None, "0", 0) else f", {failed} {failure_label}"
                    lines.append(f"LLM progress ({prefix}): {completed}/{total} completed{failed_text}")
                    final_line = final_apply_line(artifacts, prefix)
                    if final_line:
                        lines.append(final_line)
            job_status = artifacts.get(f"{prefix}_llm_job_status")
            remote_status = artifacts.get(f"{prefix}_llm_remote_status")
            if job_status:
                suffix = f" remote={remote_status}" if remote_status else ""
                lines.append(f"LLM job ({prefix}): {job_status}{suffix}")
        for key in output_keys_for_stage(str(summary.get("current_stage") or "")):
            output = artifacts.get(key)
            if output:
                lines.append(f"Output: {output}")
                break
        review_publish_line = final_review_publish_line(summary, artifacts)
        if review_publish_line:
            lines.append(review_publish_line)
    if summary.get("advanced") is not None:
        lines.append(f"Advanced: {str(summary.get('advanced')).lower()}")
    if summary.get("auto"):
        steps = summary.get("auto_steps")
        if isinstance(steps, list):
            advanced_stages = [
                str(step.get("stage"))
                for step in steps
                if isinstance(step, dict) and step.get("advanced")
            ]
            lines.append(
                "Auto stages: "
                + (", ".join(advanced_stages) if advanced_stages else "none")
            )
    if summary.get("requires_confirmation"):
        lines.append("Status: confirmation required")
    elif summary.get("blocking_reason"):
        lines.append(f"Status: blocked - {summary['blocking_reason']}")
    elif summary.get("message"):
        lines.append(f"Status: {summary['message']}")
    else:
        lines.append("Status: ok")
    next_stage = summary.get("next_stage")
    if next_stage:
        lines.append(f"Next: {next_stage}")
    else:
        lines.append(f"Log: {summary.get('log_path')}")
    return "\n".join(lines)


def should_show_llm_status(summary: dict[str, object], artifacts: dict, prefix: str) -> bool:
    stage = str(summary.get("current_stage") or "")
    if LLM_STATUS_STAGE_PREFIXES.get(stage) == prefix:
        return True
    job_status = artifacts.get(f"{prefix}_llm_job_status")
    return bool(summary.get("blocking_reason") and job_status and job_status != "completed")


def final_review_publish_line(summary: dict[str, object], artifacts: dict) -> str | None:
    if summary.get("current_stage") != "final_review_prepared":
        return None
    if not artifacts.get("review_site_manifest_json") and not artifacts.get("final_review_pack_json"):
        return None
    return "Review page: run ./publish-review to commit and push the generated docs/review artifacts."


def llm_failure_label(artifacts: dict, prefix: str) -> str:
    if prefix == "yomi_reading" and artifacts.get("yomi_reading_apply_summary_json"):
        return "raw parse failures"
    return "failed"


def final_apply_line(artifacts: dict, prefix: str) -> str | None:
    if prefix != "yomi_reading":
        return None
    checked = artifacts.get("yomi_reading_checked")
    matched = artifacts.get("yomi_reading_matched")
    mismatched = artifacts.get("yomi_reading_mismatched")
    parse_error = artifacts.get("yomi_reading_parse_error")
    missing = artifacts.get("yomi_reading_missing_result")
    if checked is None or matched is None:
        return None
    parts = [f"{checked} checked", f"{matched} matched"]
    if mismatched is not None:
        parts.append(f"{mismatched} mismatched")
    if parse_error is not None:
        parts.append(f"{parse_error} final parse errors")
    if missing is not None:
        parts.append(f"{missing} missing")
    return "Yomi reading final: " + ", ".join(str(part) for part in parts)


def output_keys_for_stage(stage: str) -> list[str]:
    stage_outputs = {
        "alphabetic_analyzed": ["units_alphabetic_jsonl"],
        "alphabetic_reported": ["alphabetic_unresolved_jsonl"],
        "alphabetic_llm_judged": ["alphabetic_judgment_results_jsonl"],
        "alphabetic_promotion_candidates": ["alphabetic_promotion_candidates_jsonl"],
        "scope_triage_queued": ["scope_triage_input_jsonl"],
        "scope_triage_llm_completed": ["units_scope_triaged_jsonl"],
        "yomi_generated": ["units_yomi_jsonl"],
        "yomi_auto_accepted": ["units_yomi_auto_accept_jsonl"],
        "yomi_reading_queued": ["yomi_reading_input_jsonl"],
        "yomi_reading_llm_completed": ["units_yomi_llm_readings_jsonl"],
        "final_review_prepared": ["final_review_pack_json", "review_site_manifest_json"],
        "final_review_applied": ["units_yomi_reviewed_jsonl"],
        "yomi_strong_repair_queued": ["yomi_strong_repair_queue_jsonl"],
        "yomi_finalized": ["units_yomi_final_jsonl"],
    }
    return stage_outputs.get(stage, []) + [
        "units_yomi_llm_readings_jsonl",
        "units_yomi_reviewed_jsonl",
        "yomi_strong_repair_queue_jsonl",
        "units_yomi_final_jsonl",
        "yomi_reading_input_jsonl",
        "units_scope_triaged_jsonl",
        "units_yomi_auto_accept_jsonl",
        "units_yomi_jsonl",
        "alphabetic_promotion_candidates_jsonl",
        "alphabetic_judgment_results_jsonl",
        "alphabetic_unresolved_jsonl",
    ]


def human_review_line(artifacts: dict) -> str | None:
    if str(artifacts.get("human_review_required", "")).lower() != "true":
        return None
    gate = str(artifacts.get("human_review_gate") or "unknown")
    count = artifacts.get("human_review_item_count")
    suffix = f" ({count})" if count not in (None, "") else ""
    return f"Human review: required - {gate}{suffix}"


def human_review_skipped_line(artifacts: dict) -> str | None:
    if str(artifacts.get("human_review_skipped", "")).lower() != "true":
        return None
    gate = str(artifacts.get("human_review_gate") or "unknown")
    return f"Human review skipped: {gate}"


if __name__ == "__main__":
    main()
