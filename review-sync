#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path


PROJECT_ROOT = Path(__file__).resolve().parent
SRC_ROOT = PROJECT_ROOT / "src"
if str(SRC_ROOT) not in sys.path:
    sys.path.insert(0, str(SRC_ROOT))

from yomi_corpus.review_sync import (  # noqa: E402
    DEFAULT_REVIEW_SYNC_CONFIG,
    ReviewSyncOptions,
    compact_console_summary,
    load_review_sync_config,
    run_review_sync_loop,
    run_review_sync_pass,
)
from yomi_corpus.review_transport import (  # noqa: E402
    DEFAULT_REVIEW_TRANSPORT_CONFIG,
    PUBLISH_MODES,
    load_review_transport_config,
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Import/apply GitHub-Issue review submissions and refresh review state."
    )
    parser.add_argument(
        "track",
        choices=["dev", "working"],
        help="Pipeline track to synchronize.",
    )
    parser.add_argument(
        "--repo",
        default=None,
        help="GitHub repository in owner/name form.",
    )
    parser.add_argument(
        "--transport-config",
        default=DEFAULT_REVIEW_TRANSPORT_CONFIG,
        help=f"Review transport TOML config. Default: {DEFAULT_REVIEW_TRANSPORT_CONFIG}.",
    )
    parser.add_argument(
        "--sync-config",
        default=DEFAULT_REVIEW_SYNC_CONFIG,
        help=f"Review sync TOML config. Default: {DEFAULT_REVIEW_SYNC_CONFIG}.",
    )
    parser.add_argument(
        "--no-close-issues",
        action="store_true",
        help="Apply local state but do not close successfully applied GitHub Issues.",
    )
    parser.add_argument(
        "--publish",
        choices=sorted(PUBLISH_MODES),
        default=None,
        help=(
            "Review artifact publish mode after a state-changing sync pass. "
            "'none' does not regenerate docs/review; 'local' regenerates docs/review; "
            "'gh-pages' regenerates and runs ./publish-review. Defaults to transport config."
        ),
    )
    parser.add_argument(
        "--max-stages",
        type=int,
        default=None,
        help="Global maximum pipeline actions in one pass. Defaults to sync config.",
    )
    parser.add_argument(
        "--max-seconds",
        type=float,
        default=None,
        help=(
            "Soft runtime limit for starting new pipeline actions. "
            "An action already in progress may finish. Defaults to sync config."
        ),
    )
    parser.add_argument(
        "--bulk-review-target-ready-docs",
        type=int,
        default=None,
        help=(
            "Target number of actionable Bulk Review documents to keep ready. "
            "Defaults to the track's review-sync config."
        ),
    )
    parser.add_argument(
        "--refill-pass-limit",
        type=int,
        default=None,
        help=(
            "Maximum documents a future refill pass may prepare. "
            "Defaults to the track's review-sync config."
        ),
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Show the next sync-managed action without modifying pipeline state.",
    )
    parser.add_argument(
        "--loop",
        action="store_true",
        help="Keep running sync passes until interrupted.",
    )
    parser.add_argument(
        "--interval",
        type=float,
        default=60.0,
        help="Seconds to sleep between --loop passes. Default: 60.",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Print the full structured summary.",
    )
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    transport = load_review_transport_config(args.track, args.transport_config)
    sync_config = load_review_sync_config(args.track, args.sync_config)
    options = ReviewSyncOptions(
        track_name=args.track,
        repo=args.repo or transport.repo,
        pages_url=transport.pages_url,
        close_issues=not args.no_close_issues,
        publish_mode=args.publish or transport.publish_mode,
        max_stages=(
            args.max_stages
            if args.max_stages is not None
            else sync_config.review_sync_max_stages
        ),
        max_runtime_seconds=(
            args.max_seconds
            if args.max_seconds is not None
            else sync_config.review_sync_max_runtime_seconds
        ),
        bulk_review_target_ready_docs=(
            args.bulk_review_target_ready_docs
            if args.bulk_review_target_ready_docs is not None
            else sync_config.bulk_review_target_ready_docs
        ),
        refill_pass_limit=(
            args.refill_pass_limit
            if args.refill_pass_limit is not None
            else sync_config.refill_pass_limit
        ),
        refill_aligned_batch_size=sync_config.refill_aligned_batch_size,
        dry_run=args.dry_run,
        runtime_status_interval_seconds=sync_config.runtime_status_interval_seconds,
        runtime_status_grace_seconds=sync_config.runtime_status_grace_seconds,
        runtime_status_normal_poll_seconds=sync_config.runtime_status_normal_poll_seconds,
        runtime_status_near_poll_seconds=sync_config.runtime_status_near_poll_seconds,
        runtime_status_hidden_poll_seconds=sync_config.runtime_status_hidden_poll_seconds,
    )
    if args.loop:
        if args.dry_run:
            raise SystemExit("--loop cannot be combined with --dry-run")
        run_review_sync_loop(PROJECT_ROOT, options, interval_seconds=args.interval)
        return
    summary = run_review_sync_pass(PROJECT_ROOT, options)
    if args.json:
        print(json.dumps(summary, ensure_ascii=False, indent=2))
    else:
        print(json.dumps(compact_console_summary(summary), ensure_ascii=False, indent=2))


if __name__ == "__main__":
    main()
