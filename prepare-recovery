#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

PROJECT_ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(PROJECT_ROOT / "src"))

from yomi_corpus.pipeline import PipelineWorkspace


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Materialize a report-only recovery campaign as a normal review batch."
    )
    parser.add_argument("campaign_dir", type=Path)
    parser.add_argument("--track", choices=("dev", "working"), default="dev")
    parser.add_argument("--batch-name")
    args = parser.parse_args()
    campaign_dir = args.campaign_dir
    if not campaign_dir.is_absolute():
        campaign_dir = (PROJECT_ROOT / campaign_dir).resolve()
    result = PipelineWorkspace(PROJECT_ROOT).prepare_recovery_batch(
        campaign_dir=campaign_dir,
        track_name=args.track,
        batch_name=args.batch_name,
    )
    print(json.dumps(result, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
